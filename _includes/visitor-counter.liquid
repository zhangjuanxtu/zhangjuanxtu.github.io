{% assign counter_config = site.homepage_visit_counter %}

<style>
  .visitor-counter-corner {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 20;
    max-width: calc(100vw - 1.5rem);
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(8px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    color: var(--global-text-color);
    font-size: 0.75rem;
    line-height: 1.3;
    opacity: 0.68;
    transition: opacity 0.2s ease;
  }

  .visitor-counter-corner:hover {
    opacity: 0.92;
  }

  .visitor-counter-corner__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.8rem;
    align-items: center;
  }

  @media (max-width: 576px) {
    .visitor-counter-corner {
      right: 0.5rem;
      bottom: 0.5rem;
      padding: 0.4rem 0.65rem;
      font-size: 0.7rem;
    }
  }
</style>

<div class="visitor-counter-corner" aria-label="Homepage visit statistics">
  <div class="visitor-counter-corner__stats" role="status">
    <span id="busuanzi_container_site_uv" style="display: none;">
      {{ counter_config.visitor_label | default: 'Visitors' }}
      <span id="busuanzi_value_site_uv"></span>
    </span>
    <span id="busuanzi_container_page_pv" style="display: none;">
      {{ counter_config.page_view_label | default: 'Homepage Views' }}
      <span id="busuanzi_value_page_pv"></span>
    </span>
  </div>
</div>
