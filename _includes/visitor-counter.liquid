{% assign counter_config = site.homepage_visit_counter %}

<span
  class="text-muted"
  aria-label="Homepage visit statistics"
  style="display: inline-block; margin-left: 0.6rem; font-size: 0.42em; font-weight: 400; line-height: 1.2; vertical-align: middle; white-space: nowrap;"
>
  <span id="busuanzi_container_site_uv" style="display: none;">
    {{ counter_config.visitor_label | default: 'Visitors' }}
    <span id="busuanzi_value_site_uv"></span>
  </span>
  <span id="busuanzi_container_page_pv" style="display: none;">
    · {{ counter_config.page_view_label | default: 'Homepage Views' }}
    <span id="busuanzi_value_page_pv"></span>
  </span>
</span>
